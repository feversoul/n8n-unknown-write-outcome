    {
      "parameters": {
        "jsCode": "// Settings.\nconst RECHECK_AFTER_SECONDS = [60, 300, 900]; // wait before lookup 1, 2, 3. Still nothing after the last one: review. Set the total above the slowest settle time you measured.\nconst REVIEW_RECHECK_SECONDS = 1800; // how often a job in review is looked up again\nconst USE_RECEIPT = true; // false if your API has no authoritative \"this write was not applied\" answer\nconst LEASE_SECONDS = 300; // a row still \"sending\" after this long belongs to a run that died; it is treated as unknown\nconst MAX_PER_SWEEP = 50; // jobs handled per run\nconst ALERT_URL = ''; // where the two alerts are posted as JSON (Slack workflow, another webhook). Empty: no alert, the rows still say it.\n\nreturn [{ json: {\n  recheck_after_seconds: RECHECK_AFTER_SECONDS,\n  review_recheck_seconds: REVIEW_RECHECK_SECONDS,\n  use_receipt: USE_RECEIPT,\n  lease_seconds: LEASE_SECONDS,\n  max_per_sweep: MAX_PER_SWEEP,\n  alert_url: ALERT_URL,\n} }];"
      },
      "id": "c11d3a03-9324-4019-8e98-2acf772612ad",
      "name": "Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
