      "parameters": {
        "jsCode": "const parse = (text, fallback) => { try { return JSON.parse(text); } catch { return fallback; } };\nconst jobs = $input.all().map((item) => item.json).filter((row) => row.id !== undefined)\n  .map((row) => ({ ...row, payload: parse(row.payload, {}), history: parse(row.history, []) }));\nreturn [{ json: { jobs } }];"
      },
