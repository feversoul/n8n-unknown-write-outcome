# Any long random string. n8n encrypts stored credentials with it.
N8N_ENCRYPTION_KEY=
# Any long random string. Callers send it as the header X-Workflow-Key.
WORKFLOW_KEY=
# Port of the n8n editor and the webhooks on this machine.
N8N_PORT=5678
# Port of the fixture on this machine.
FIXTURE_PORT=8080
