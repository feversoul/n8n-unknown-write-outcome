# Values for the end-to-end test stack only. Nothing here is a real secret.
N8N_ENCRYPTION_KEY=test-key
WORKFLOW_KEY=test-workflow-key
N8N_PORT=55686
FIXTURE_PORT=58088
# Seconds instead of minutes: the write gives up after 400 ms (the fixture
# never answers the first write), three rechecks one second apart, then review.
WRITE_TIMEOUT_MS=400
RECHECK_AFTER_SECONDS=1,1,1
REVIEW_RECHECK_SECONDS=1
SWEEP_INTERVAL_SECONDS=1
ALERT_URL=http://fixture:8080/alerts
